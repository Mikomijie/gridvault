# Ignore everything by default
/*

# Whitelist documentation & diagrams
!.gitignore
!.nvmrc
!.editorconfig
!README.md
!/docs/
!/docs/**
!/diagrams/
!/diagrams/**
!/.github/
!/.github/**

# Explicitly ignored design and requirements documents
RELEASE-NOTES.md
PRD.md
AGENTS.md
DESIGN.md

# Whitelist root monorepo & project configuration files
!package.json
!package-lock.json
!.env.example
!docker-compose.yml
!eslint.config.js
!.prettierrc
!.prettierignore
!tsconfig.json
!vitest.config.ts
!playwright.config.ts

# Whitelist source directories
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!/witness/
!/witness/**
!/scripts/
!/scripts/**

# Re-ignore OS, build, dependencies, and environment artifacts within whitelisted directories
**/.DS_Store
**/*.log
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/data/
**/*.db
**/*.db-wal
**/*.db-shm
**/.env
**/.env.local
**/.env.*.local
!**/.env.example